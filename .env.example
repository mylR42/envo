# Copier dans /srv/envo/envo.env sur le serveur (jamais dans le dépôt).
PUBLIC_URL=https://envo.example.fr
PORT=3880
# Chiffre les clés Interfast des comptes. NE JAMAIS LA CHANGER une fois en service.
ENVO_SECRET_KEY=
# L'assistante. Sans clé, l'app marche mais AssistDevis est désactivé.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Lecture d'Interfast pour le tableau de bord : la vitesse compte.
ANTHROPIC_MODEL_TABLEAU=claude-sonnet-5-5
# low | medium | high
ANTHROPIC_EFFORT=medium
# E-mails (codes de connexion). Sans Mailjet, les codes sont écrits dans le journal du serveur.
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
MAIL_FROM=
MAIL_FROM_NAME=Envo
# PostgreSQL : socket Unix, authentification « peer »
PGHOST=/var/run/postgresql
PGDATABASE=envo
PGUSER=envo
