{
  "name": "envo",
  "private": true,
  "version": "0.4.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "node --experimental-strip-types server/main.ts",
    "build": "npm run typecheck && vite build && npm run build:api",
    "build:api": "esbuild server/main.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist-server/server.mjs --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\"",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.server.json",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@fontsource/manrope": "^5.3.0",
    "@hono/node-server": "^2.1.6",
    "@phosphor-icons/react": "^2.1.10",
    "hono": "^4.13.17",
    "postgres": "^4.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
